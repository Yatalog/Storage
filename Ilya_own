-- ================= ОСНОВНОЙ ЦИКЛ =================
task.spawn(function()
    while task.wait(0.2) do
        if not isFarming then continue end

        local character = player.Character
        local humanoid = character and character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local renderedEggs = workspace:FindFirstChild("RenderedEggs")
        if not renderedEggs then continue end

        local targetEgg = nil
        local targetEggName = nil

        for _, egg in pairs(renderedEggs:GetChildren()) do
            if coolEggs[egg.Name] then
                local handle = egg:FindFirstChild("Handle")
                if handle then
                    targetEgg = handle
                    targetEggName = egg.Name
                    break
                end
            end
        end

        if targetEgg then
            print("Лечу к яйцу:", targetEggName)
            local eggPos = targetEgg.Position - Vector3.new(0, 1, 0)
            tweenTo(eggPos, 2, true)

            if not isFarming then break end

            local eggModel = targetEgg.Parent
            if eggModel then
                print("Пробую подобрать яйцо:", eggModel.Name)
                for _, event in pairs(knownEvents) do
                    pcall(function()
                        event:FireServer(eggModel)
                        event:FireServer(targetEgg)
                        event:FireServer()
                    end)
                end
                pcall(function()
                    eggPickupRemote:FireServer("PickedUp", eggModel.Name, "UUID")
                end)
                task.wait(1)
            end

            if not isFarming then break end

            local plots = workspace:FindFirstChild("Plots")
            if plots then
                for _, plot in pairs(plots:GetChildren()) do
                    if not isFarming then break end
                    local baseplate = plot:FindFirstChild("Baseplate")
                    if baseplate then
                        print("Лечу к базе:", plot.Name)
                        tweenTo(baseplate.Position, 0.5, false)
                    end
                end
            end
        end
    end
end)
