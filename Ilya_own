-- ============================================

local function scanForEvents()
    for _, desc in pairs(game:GetDescendants()) do
        if desc:IsA("RemoteEvent") then
            if not table.find(knownEvents, desc) then
                table.insert(knownEvents, desc)
                print("[SCAN] Найден RemoteEvent:", desc:GetFullName())
            end
        end
    end
end

game.DescendantAdded:Connect(function(desc)
    if desc:IsA("RemoteEvent") then
        if not table.find(knownEvents, desc) then
            table.insert(knownEvents, desc)
            print("[NEW] Найден RemoteEvent:", desc:GetFullName())
        end
    end
end)

local function tweenTo(targetPosition, waitTime, freeze)
    if not isFarming then return end
    local character = player.Character
    local humanoid = character and character:FindFirstChild("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not humanoid or humanoid.Health <= 0 then return end

    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    if freeze then root.Anchored = true end

    local tweenInfo = TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(targetPosition)})
    tween:Play()
    tween.Completed:Wait()

    task.wait(waitTime)

    if freeze then root.Anchored = false end
    humanoid.WalkSpeed = 16
    humanoid.JumpPower = 50
end

